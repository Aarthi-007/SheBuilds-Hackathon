# Klyros Backend Configuration Template

# Groq API Key (Get your key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Models Configuration
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=llama-3.2-11b-vision-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=klyros

# Security & Authentication
JWT_SECRET=super-secret-klyros-hackathon-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base Application URL
BASE_URL=http://localhost:8000
