# Klyros Backend Configuration Template

# Default AI provider
AI_PROVIDER=qwen
VISION_PROVIDER=qwen
TEXT_PROVIDER=qwen

# Groq API Key (legacy support; not used by default)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Models Configuration
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=llama-3.3-70b-versatile
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Qwen2.5-VL / OpenAI-compatible provider
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://api.together.xyz/v1
QWEN_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=klyros

# Security & Authentication
JWT_SECRET=super-secret-klyros-hackathon-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base Application URL
BASE_URL=http://localhost:8000
